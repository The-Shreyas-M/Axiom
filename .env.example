# Axiom - environment variables

# --- LLM provider --------------------------------------------------------
# Which backend to use for classification/answer/caption generation:
#   "groq"   -> Groq API (uses GROQ_API_KEY)          <-- fast, free tier
#   "gemini" -> Google Gemini (uses GEMINI_API_KEY)
#   "ollama" -> local Ollama server (needs ollama serve)
#   "nvidia" -> NVIDIA NIM API (uses NVIDIA_API_KEY)
# Unset -> auto: groq if GROQ_API_KEY set, else nvidia if NVIDIA_API_KEY set, else gemini if GEMINI_API_KEY set, else ollama.
LLM_PROVIDER=groq

# Groq API key (get a free key at https://console.groq.com/).
GROQ_API_KEY=

# Groq model name (default mixtral-8x7b-32768).
GROQ_MODEL=mixtral-8x7b-32768

# Google Gemini API key (used when LLM_PROVIDER=gemini).
GEMINI_API_KEY=

# Gemini model override (default gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Ollama base URL + model (used when LLM_PROVIDER=ollama).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=gemma3:4b

# NVIDIA NIM API key (recommended backend; free at https://build.nvidia.com).
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# NVIDIA_VISION_MODEL=

# --- Gradio UI -----------------------------------------------------------
# Set to true to expose the UI through a public share tunnel.
# Keep false for local-only access (http://127.0.0.1:7860).
GRADIO_SHARE=false